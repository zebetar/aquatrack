
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin(userId) {
      return exists(/databases/$(database)/documents/admins/$(userId));
    }

    // Admins collection: Only other admins can read/write admin documents.
    // This prevents a non-admin from making themselves an admin.
    // In a real app, you might restrict this further or manage admins differently.
    match /admins/{adminId} {
      allow read, write: if request.auth != null && isAdmin(request.auth.uid);
    }
    
    // Users collection: Contains public profile info.
    match /users/{userId} {
        // Any authenticated user can read any profile (for display names, etc.)
        allow get: if request.auth != null;
        // A user can only create or update their own profile document.
        allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Customers collection
    match /customers/{customerId} {
      // Allow full access to any document if the user is an admin.
      allow read, write, create, delete: if request.auth != null && isAdmin(request.auth.uid);

      // Viewer access for their OWN document
      // Authenticated, their UID matches authUID in the doc, and they are NOT an admin.
      allow get: if request.auth != null && request.auth.uid == resource.data.authUID;
    }
    
    // Rules for collection-level operations on 'customers'
    match /customers/{docIdWildcard} {
        // Admins can perform list/query operations.
        allow list: if request.auth != null && isAdmin(request.auth.uid);
        
        // A specific rule to allow a logged-in viewer to query for their OWN customer document.
        // This is crucial for the login flow to find which customer record belongs to the Auth user.
        // Firestore security rules will then apply document-level 'get' rules to the results.
        allow list: if request.auth != null && request.query.limit == 1 && request.query.where[0][0] == 'authUID' && request.query.where[0][2] == request.auth.uid;
    }

    // UsageRecords collection group
    match /{path=**}/usageRecords/{usageRecordId} {
      // Admins can read/write/create/delete any usage record.
      allow read, write, create, delete: if request.auth != null && isAdmin(request.auth.uid);

      // Viewers can read their own usage records (get and list).
      // We verify ownership by checking the authUID on the parent customer document.
      allow get, list: if request.auth != null &&
                    get(/databases/$(database)/documents/customers/$(path[1])).data.authUID == request.auth.uid;
    }

    // Payments collection group
    match /{path=**}/payments/{paymentId} {
      // Admins have full control.
      allow read, write, create, delete: if request.auth != null && isAdmin(request.auth.uid);
      
      // Viewers can read their own payments.
      allow get, list: if request.auth != null &&
                    get(/databases/$(database)/documents/customers/$(path[1])).data.authUID == request.auth.uid;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Admins can manage all notifications
      allow read, write, create, delete: if request.auth != null && isAdmin(request.auth.uid);

      // Users can read notifications where their userId matches the notification's userId.
      allow get, list: if request.auth != null && request.auth.uid == resource.data.userId;

      // Allow users to update their own notifications (e.g., mark as read)
      allow update: if request.auth != null && request.auth.uid == resource.data.userId &&
                       request.resource.data.keys().hasOnly(['isRead']); // Only allow updating 'isRead'
    }
  }
}
